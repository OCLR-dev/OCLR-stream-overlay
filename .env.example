PORT=3001
OCLR_API_BASE_URL=https://oclr.org
# Explicit anonymous public reads by default. Use bearer to read with your saved Key.
OCLR_AUTH_MODE=anonymous
OCLR_API_KEY=
# Optional server-only credential file; only OCLR_API_KEY is read from it.
OCLR_CREDENTIALS_FILE=
# Must match the origin bound when the backend issued the Key.
OCLR_API_ORIGIN=http://localhost:3000
TOSU_WS_URL=ws://127.0.0.1:24050/websocket/v2
