{
  "name": "oclr-stream-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "custom": "node server/custom-match.js",
    "start": "node server/index.js",
    "dev": "vite",
    "check": "vue-tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "sim": "node tools/tosu-simulator/index.js",
    "sim:test": "node --test test/tosu-websocket.test.js",
    "sim:timing": "node tools/tosu-diagnostics/result-timing.js",
    "tosu:record": "node tools/tosu-diagnostics/record.js",
    "test": "node --experimental-strip-types --test test/*.test.js test/*.test.ts"
  },
  "dependencies": {
    "rosu-pp-js": "4.0.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
